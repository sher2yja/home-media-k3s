  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  claimRef:
    namespace: media
    name: jellyfin-config
  hostPath:
    path: {jellyfin}
    type: Directory
